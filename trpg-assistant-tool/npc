from storage import load_npcs, save_npcs

def add_npc(name, age, occupation, role, note):
    npc = {
        "name": name,
        "age": age,
        "occupation": occupation,
        "role": role,
        "note": note
    }

    npcs = load_npcs()
    npcs.append(npc)
    save_npcs(npcs)

def get_all_npcs():
    return load_npcs()

def search_npcs(keyword):
    npcs = load_npcs()
    keyword = keyword.lower()

    results = []

    for npc in npcs:
        if keyword in npc["name"].lower():
            results.append(npc)

    return results

def delete_npc(index):
    npcs = load_npcs()

    if index < 0 or index >= len(npcs):
        return False

    npcs.pop(index)
    save_npcs(npcs)
    return True
