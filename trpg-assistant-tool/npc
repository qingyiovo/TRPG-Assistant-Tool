from storage import load_npcs, save_npcs


def add_npc(name, age, occupation, role, note, portrait=""):
    npc = {
        "name": name,
        "age": age,
        "occupation": occupation,
        "role": role,
        "note": note,
        "portrait": portrait
    }

    npcs = load_npcs()
    npcs.append(npc)
    save_npcs(npcs)


def get_all_npcs():
    return load_npcs()


def update_npc(index, name, age, occupation, role, note, portrait=""):
    npcs = load_npcs()

    if index < 0 or index >= len(npcs):
        return False

    npcs[index] = {
        "name": name,
        "age": age,
        "occupation": occupation,
        "role": role,
        "note": note,
        "portrait": portrait
    }

    save_npcs(npcs)
    return True


def delete_npc(index):
    npcs = load_npcs()

    if index < 0 or index >= len(npcs):
        return False

    npcs.pop(index)
    save_npcs(npcs)
    return True
