from storage import load_npcs, save_npcs


def create_npc(data):
    npcs = load_npcs()
    npcs.append(data)
    save_npcs(npcs)


def get_all_npcs():
    return load_npcs()


def update_npc(index, data):
    npcs = load_npcs()

    if index < 0 or index >= len(npcs):
        return False

    npcs[index] = data
    save_npcs(npcs)
    return True


def delete_npc(index):
    npcs = load_npcs()

    if index < 0 or index >= len(npcs):
        return False

    npcs.pop(index)
    save_npcs(npcs)
    return True
